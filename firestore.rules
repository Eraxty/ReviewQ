rules_version = '2';

// Community reviews. Anyone can read them; signed-in people can post one
// review per project, edit or delete their own, and nothing else.
//
// Moderation from the Firebase console:
//   admins/<uid>  any document here lets that user delete any review and ban people
//   banned/<uid>  any document here stops that user from posting or editing
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isBanned() {
      return exists(/databases/$(database)/documents/banned/$(request.auth.uid));
    }

    function text(value, max) {
      return value is string && value.size() <= max;
    }

    function validReview(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['project_id', 'uid', 'author', 'photo', 'verdict', 'tier', 'claimed_hours',
                               'hours', 'technical_features', 'deflation_reason', 'notes', 'note',
                               'created_at', 'updated_at'])
        && d.keys().hasAll(['project_id', 'uid', 'author', 'photo', 'verdict', 'tier', 'claimed_hours',
                            'hours', 'technical_features', 'deflation_reason', 'notes', 'note',
                            'created_at', 'updated_at'])
        && d.project_id is string && d.project_id.matches('[0-9]{1,8}')
        // One review per person per project: the id is <project>_<uid>.
        && id == d.project_id + '_' + request.auth.uid
        && d.uid == request.auth.uid
        // Name and photo come from the Google account, so nobody can post as someone else.
        && d.author == request.auth.token.get('name', '')
        && d.photo == request.auth.token.get('picture', '')
        && d.verdict in ['approved', 'needs_changes', 'ban']
        && d.tier is int && d.tier >= 1 && d.tier <= 4
        && d.claimed_hours is number && d.claimed_hours >= 0 && d.claimed_hours <= 5000
        && d.hours is number && d.hours >= 0 && d.hours <= d.claimed_hours
        && text(d.technical_features, 6000) && d.technical_features.size() >= 20
        && text(d.deflation_reason, 4000)
        && text(d.notes, 6000)
        && text(d.note, 4000) && d.note.size() > 0
        && d.updated_at == request.time;
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn() && !isBanned() && validReview(id)
        && request.resource.data.created_at == request.time;
      allow update: if signedIn() && !isBanned() && resource.data.uid == request.auth.uid && validReview(id)
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Lets the page know whether to show moderation buttons.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /banned/{uid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
